#!/bin/bash
set -e

install_launch_daemon() {
    local src="$1"
    local dest="$2"

    if [ -f "$dest" ]; then
        launchctl unload -w "$dest" || true
        rm -fv "$dest"
    fi

    cp -v "$src" "$dest"
    launchctl load -w "$dest"
}

# Create log dir and ensure correct permissions
mkdir -p "$3/Library/Logs/Electros LaunchPad" -m 755

install_launch_daemon \
    "$3@CPACK_PACKAGING_INSTALL_PREFIX@/Resources/@ELP_API_PLIST@" \
    "$3/Library/LaunchDaemons/@ELP_API_PLIST@"

install_launch_daemon \
    "$3@CPACK_PACKAGING_INSTALL_PREFIX@/Resources/@ELP_LLM_PROXY_PLIST@" \
    "$3/Library/LaunchDaemons/@ELP_LLM_PROXY_PLIST@"

exit 0
