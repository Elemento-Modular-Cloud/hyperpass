#!/bin/sh -e

http_proxy="$(snapctl get proxy.http)"
https_proxy="$(snapctl get proxy.https)"
HYPERPASS_VM_DRIVER="$(snapctl get driver)"

if [ -n "$http_proxy" ]; then
    export http_proxy
fi

if [ -n "$https_proxy" ]; then
    export https_proxy
fi

export HYPERPASS_VM_DRIVER

exec "$SNAP/bin/hyperpassd" --verbosity debug --logger platform "${@}"
